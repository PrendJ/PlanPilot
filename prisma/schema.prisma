generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  name                String
  passwordHash        String
  isAdmin             Boolean           @default(false)
  canCreateWorkspaces Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sessions            Session[]
  memberships         WorkspaceMember[]
  createdWorkspaces   Workspace[]       @relation("WorkspaceCreator")
  updateLogs          UpdateLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  openrouterKeyEnv   String            @default("")
  planModel          String            @default("openai/gpt-5-nano")
  transcriptionModel String           @default("openai/gpt-4o-mini-transcribe")
  dictationEnabled   Boolean           @default(true)
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          User              @relation("WorkspaceCreator", fields: [createdById], references: [id])
  members            WorkspaceMember[]
  columns            BoardColumn[]
  cards              Card[]
  updateLogs         UpdateLog[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model BoardColumn {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  position    Int
  kind        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards       Card[]

  @@unique([workspaceId, kind])
  @@index([workspaceId, position])
}

model Card {
  id          String      @id @default(cuid())
  workspaceId String
  columnId    String
  title       String
  description String      @default("")
  priority    String      @default("NORMAL")
  dueDate     DateTime?
  tags        Json        @default("[]")
  position    Int         @default(0)
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  column      BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([workspaceId, archived])
  @@index([columnId, position])
}

model UpdateLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  source      String
  inputText   String    @db.Text
  summary     String    @default("")
  actions     Json
  model       String
  cost        Float?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
