{
  "name": "boardcue-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/prepare-standalone.mjs && playwright test",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "license:grant": "tsx scripts/grant-license.ts",
    "workspace:create": "tsx scripts/create-workspace.ts",
    "membership:add": "tsx scripts/add-membership.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "2.4.3",
    "next": "15.5.23",
    "nodemailer": "9.0.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "18.5.0",
    "zod": "3.25.76",
    "prisma": "6.12.0",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.3",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.0"
  }
