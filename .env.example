# Required by Docker Compose. Use a long random password made only of letters,
# numbers, dots, underscores and hyphens (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me-with-a-long-random-password
APP_URL=http://localhost:3000

# Required to use AI text updates and transcription.
OPENROUTER_API_KEY=
# Alternative to OPENROUTER_API_KEY: per-workspace keys as JSON, keyed by workspace slug.
# Leave OPENROUTER_API_KEY empty when using this setting: the shared key has priority.
# OPENROUTER_WORKSPACE_KEYS={"workspace-slug":"sk-or-v1-..."}

# Optional: required only to enable paid subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_STUDIO=

# Optional: required to send verification, reset and Enterprise emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BoardCue AI <noreply@your-domain.tld>
SALES_EMAIL=
SALES_BOOKING_URL=

# Optional: required to call the protected cron endpoints.
CRON_SECRET=
# Optional operating defaults; normally leave their values unchanged.
# Used only if the daily reference rate cannot be obtained.
USD_TO_EUR_FALLBACK=0.92
MONTHLY_FIXED_COST_EUR=30
