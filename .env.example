# Required by Docker Compose. Use a long random password made only of letters,
# numbers, dots, underscores and hyphens (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me-with-a-long-random-password
APP_URL=http://localhost:3000
# Required in production: encrypts two-step verification secrets at rest (any long random string).
# Changing it invalidates existing 2FA enrolments.
APP_ENCRYPTION_KEY=

# --- AI (OpenRouter, zero data retention) ----------------------------------------------
# Required to use AI text updates and dictation.
OPENROUTER_API_KEY=
# Alternative to OPENROUTER_API_KEY: per-workspace keys as JSON, keyed by workspace slug.
# OPENROUTER_WORKSPACE_KEYS={"workspace-slug":"sk-or-v1-..."}
# Optional: https://eu.openrouter.ai/api/v1 for EU in-region routing (requires the OpenRouter Business plan).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional provider allowlist (OpenRouter slugs, comma separated). Empty = any endpoint with zero data retention.
AI_PROVIDER_ONLY=

# --- Billing (Stripe) -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Current plans need no Price IDs: products (boardcue_pro, boardcue_team, boardcue_business, boardcue_ai_credits)
# and prices are created in the Stripe account on first checkout, from the amounts in lib/plans.ts.
# Previous flat prices: keep the existing values so current subscribers are recognised.
# STRIPE_PRICE_TEAM is the old €24 flat Team (mapped to TEAM_LEGACY), not the new per-seat Team.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_STUDIO=
# Set to false only if Stripe Tax is not activated on the account.
STRIPE_TAX_ENABLED=true

# --- Email --------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BoardCue <noreply@your-domain.tld>
SALES_EMAIL=
SALES_BOOKING_URL=

# --- Legal identity (shown in footer, emails and legal pages) ------------------------------
LEGAL_ENTITY_NAME=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
CONTACT_EMAIL=
PRIVACY_EMAIL=
HOSTING_PROVIDER=
HOSTING_LOCATION=
SMTP_PROVIDER_NAME=
SMTP_PROVIDER_LOCATION=

# --- Jobs ---------------------------------------------------------------------------------
# Protected cron endpoints: POST hourly /api/cron/retention and every minute /api/cron/notifications
# with Authorization: Bearer <CRON_SECRET> (see docs/OPERATIONS.md).
CRON_SECRET=
USD_TO_EUR_FALLBACK=0.92
# Your monthly infrastructure costs, used by the back-office economics (docs/PRICING_ECONOMICS.md).
MONTHLY_FIXED_COST_EUR=60
APP_VERSION=

# Optional project Web Push; enable only after configuring keys and the cron job.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
